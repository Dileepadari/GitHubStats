# Database Connection (Supabase / PostgreSQL on your server)
DATABASE_URL=postgresql://postgres:your_db_password@your_host:5432/postgres

# GitHub Personal Access Token (for higher rate limits: 5000 req/hr and private contributions)
# Optional but strongly recommended for production Vercel deployment
GITHUB_TOKEN=your_github_personal_access_token_here

# App URL (optional, defaults to request host or VERCEL_URL)
NEXT_PUBLIC_APP_URL=

# Salt for hashing visitor IPs in the view log. Without it, no IP is stored at
# all: an unsalted hash of an IPv4 address is reversible in minutes, so hashing
# without a salt would only look like anonymisation.
#   openssl rand -hex 32
IP_HASH_SALT=
